  "requirements": [
    {
      "id": "A01",
      "rule": "Preserve written instructions through the frozen contract",
      "status": "implemented"
    },
    {
      "id": "A02",
      "rule": "Keep photographed inventory, geometry, connectors and patterns; distinguish visual assembly from verified compatibility",
      "status": "implemented_specific_case"
    },
    {
      "id": "A03",
      "rule": "Separate owner approval, passed review and exceptions",
      "status": "in_progress"
    },
    {
      "id": "A04",
      "rule": "Independent output evidence and blind counts",
      "status": "partial"
    },
    {
      "id": "A05",
      "rule": "Reserve all paid calls, not image calls alone",
      "status": "pending"
    },
    {
      "id": "A06",
      "rule": "Unknown provider outcomes never trigger an automatic resend",
      "status": "partial"
    },
    {
      "id": "A07",
      "rule": "Account for every requested output and saved delivery receipt",
      "status": "in_progress"
    },
    {
      "id": "A08",
      "rule": "Owner can correct the understood brief before production",
      "status": "partial"
    },
    {
      "id": "A09",
      "rule": "Keep product, room, accepted context, inspiration and specification roles distinct",
      "status": "pending"
    },
    {
      "id": "A10",
      "rule": "Unknown or hidden geometry is not invented as fact",
      "status": "partial"
    },
    {
      "id": "A11",
      "rule": "Use least destructive normalization that satisfies the approved outcome",
      "status": "pending"
    },
    {
      "id": "A12",
      "rule": "Freeze the full output plan before generation",
      "status": "partial"
    },
    {
      "id": "A13",
      "rule": "Expose review evidence, uncertainty and score basis",
      "status": "partial"
    },
    {
      "id": "A14",
      "rule": "Owner-ordered targeted repairs preserve previously correct features; maximum two per image",
      "status": "partial"
    },
    {
      "id": "A15",
      "rule": "No unknown or exception is silently represented as a passed catalogue release",
      "status": "in_progress"
    },
    {
      "id": "A16",
      "rule": "Verify requested channel formats, dimensions and checksums",
      "status": "partial"
    },
    {
      "id": "A17",
      "rule": "Private delivery retains source and approval lineage",
      "status": "partial"
    },
    {
      "id": "A18",
      "rule": "Projects contain separate product or set cases, versioned jobs and saved continuation context",
      "status": "pending"
    },
    {
      "id": "A19",
      "rule": "Historical examples are evidence and evaluation fixtures, not proof a new output passed",
      "status": "partial"
    },
    {
      "id": "A20",
      "rule": "Use confirmed Midas props only; missing props stay empty",
      "status": "partial"
    },
    {
      "id": "A21",
      "rule": "Related views preserve the approved room and product continuity",
      "status": "partial"
    },
    {
      "id": "A22",
      "rule": "Separate cost estimates, token counts and actual charges; cost per complete accepted package",
      "status": "pending"
    },
    {
      "id": "A23",
      "rule": "Hold, failure and recovery are explicit owner states",
      "status": "partial"
    },
    {
      "id": "A24",
      "rule": "Variations are explicitly requested and approved independently",
      "status": "partial"
    },
    {
      "id": "A25",
      "rule": "Studio generation and consumer VTON remain distinct scope",
      "status": "implemented"
    },
    {
      "id": "A26",
      "rule": "Retention and recovery ownership need an explicit policy",
      "status": "pending"
    }
